            />
          </div>
          <div class="p-8">
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="px-2 py-1 bg-secondary-container/10 text-secondary text-[10px] rounded uppercase font-bold tracking-widest">
                {project.tag}
              </span>
            </div>
            <h3 class="text-h3 text-white mb-3">{project.title}</h3>
            <p class="text-on-surface-variant mb-6">{project.description}</p>
            <div class="flex gap-4">
              {project.buttons.map((button: any) => (
                <button class="bg-secondary-container text-white px-5 py-2 rounded font-semibold text-sm transition-opacity hover:opacity-90">
                  {button.label}
                </button>
              ))}
              {/* <button class="border border-outline text-on-surface px-5 py-2 rounded font-semibold text-sm hover:border-secondary transition-all">
                Code
              </button> */}
            </div>
          </div>
        </div>
      </li>
    ))
  }
</ul>

<style>
  ul {
    list-style: none;
  }

  .carousel {
    /* margin: 5rem; */
    padding: 1rem;
    /* border: 5px solid green; */

    display: grid;
    gap: 2rem;
    grid-auto-flow: column;
    grid-auto-columns: 50%;

    overflow-x: auto;
    scroll-snap-type: x mandatory;

    @media (prefers-reduced-motion: no-preference) {
      scroll-behavior: smooth;
    }

    anchor-name: --carousel;

    scroll-marker-group: after;

    &::scroll-marker-group {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
      /* color-scheme: dark; */
      padding: 1rem;
    }

    > li {
      scroll-snap-align: center;

      &::scroll-marker {
        content: " ";
        width: 1rem;
        height: 1rem;
        aspect-ratio: 1 / 1;
        border-radius: 100%;
        border: 1px solid snow;
      }

      &::scroll-marker:target-current {
        background: LinkText;
      }
    }

    &::scroll-button(*) {
      position: fixed;
      position-anchor: --carousel;
      /* margin: 1rem; */
      aspect-ratio: 1;
      /* font-size: 1rem; */
      /* font: inherit; */
      /* background: dodgerblue; */
      background: transparent;
      color-scheme: dark;
      /* border: 0; */
      border-radius: 100%;
      /* font-weight: 700; */
    }

    &::scroll-button(right) {
      content: "⮕" / "Scroll Right";
      position-area: center right;
    }

    &::scroll-button(left) {
      content: "⬅" / "Scroll Left";
      position-area: center left;
    }
  }
</style>
